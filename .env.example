# PoolGuard local configuration template.
#
# For a public NEAR testnet deployment use .env.testnet.example and the
# read-only `pnpm testnet:preflight` / `pnpm testnet:verify` gates instead.
#
# Copy to .env and replace the two CHANGEME secrets:
#   cp .env.example .env
#   openssl rand -base64 32        # SESSION_SECRET (any 32+ chars)
#   openssl rand -base64 32        # DOCUMENT_ENCRYPTION_KEY (must decode to 32 bytes)
#
# `pnpm sandbox` writes .env.local with ephemeral NEAR sandbox accounts/keys.
# Never put an owner seed phrase or owner private key in this file.

NODE_ENV=development

# PostgreSQL for the API, worker and provider metadata. Docker Compose default.
DATABASE_URL="postgresql://poolguard:poolguard@127.0.0.1:55432/poolguard"

# ------------------------------------------------------------------ NEAR
# sandbox is local only; testnet is the hackathon target. Never mainnet.
NEAR_NETWORK=sandbox
NEAR_RPC_URL=http://127.0.0.1:3030
POOLGUARD_CONTRACT_ID=poolguard.sandbox
POOLGUARD_OWNER_ACCOUNT_ID=owner.sandbox
OWNER_ACCOUNT_ID=owner.sandbox

# Provider identity that receives payouts. Operator-controlled fixture.
PROVIDER_ACCOUNT_ID=extract.sandbox
PROVIDER_ORIGIN=http://127.0.0.1:4103
PROVIDER_SERVICE_DOMAIN=127.0.0.1:4103
PROVIDER_PORT=4103

# Worker identities. Each must be a separate account with a restricted
# function-call key limited to the PoolGuard contract. Empty values are
# intentionally not enough: the API refuses to create tasks without both.
WORKER_ONE_ACCOUNT_ID=
WORKER_ONE_PRIVATE_KEY=
WORKER_TWO_ACCOUNT_ID=
WORKER_TWO_PRIVATE_KEY=

# Only for the explicitly gated local sandbox setup helper. Never set this on
# testnet and never give it to a browser bundle, model or provider.
SANDBOX_OWNER_PRIVATE_KEY=

# A deliberately non-allowlisted account for scenario C's contract probe.
POLICY_PROBE_PROVIDER_ACCOUNT_ID=

# ------------------------------------------------------------------ origins
API_ORIGIN=http://127.0.0.1:4100
API_HOST=127.0.0.1
API_PORT=4100
WEB_ORIGIN=http://127.0.0.1:3000
# Optional: the wallet modal uses this receiver. Not required for sandbox.
NEXT_PUBLIC_POOLGUARD_CONTRACT_ID=

# ------------------------------------------------------------------ sessions
# At least 32 characters. Used to hash session cookies, not a blockchain key.
SESSION_SECRET=CHANGEME
# base64 of exactly 32 bytes, used for AES-256-GCM document encryption at rest.
DOCUMENT_ENCRYPTION_KEY=CHANGEME

# ------------------------------------------------------------------ local safety
# Dev-session and fault injection are local-sandbox-only. Both are rejected in
# production by the API regardless of these values.
LOCAL_SANDBOX_MODE=false
ALLOW_DEV_SESSION=false
FAULT_INJECTION_ENABLED=false

# ------------------------------------------------------------------ workers
WORKER_ID=worker-local
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=90

# ------------------------------------------------------------------ AI
# Any OpenAI-compatible chat-completions endpoint. Live mode is unavailable
# when AI_API_KEY is blank; the UI then labels runs as scripted fixtures.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000
