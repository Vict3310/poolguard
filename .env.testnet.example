# PoolGuard public NEAR testnet template.
#
# Copy this file to `.env.testnet` and replace every placeholder:
#   cp .env.testnet.example .env.testnet
#   chmod 600 .env.testnet
#
# `.env.testnet` is gitignored. Never commit it, paste it into chat, or put an
# owner/deployer seed phrase or full-access key in it. The app only needs the
# contract-scoped worker keys; the owner signs setup transactions in the wallet.
#
# The variables in this file override `.env`; the real process environment
# overrides both (so a hosting secret manager can inject values at runtime).
# This project is testnet-only. `pnpm testnet:preflight` rejects mainnet RPCs,
# mainnet chain IDs and non-.testnet account names.

NODE_ENV=production

# --------------------------------------------------------------- PostgreSQL
# Use a managed database with TLS, backups and least-privilege credentials.
DATABASE_URL="postgresql://poolguard:CHANGEME@db.example.com:5432/poolguard?sslmode=require"

# ------------------------------------------------------------------- NEAR
NEAR_NETWORK=testnet
NEAR_RPC_URL="https://rpc.testnet.near.org"

# Contract account. Deploy with the deployer key kept outside this file.
POOLGUARD_CONTRACT_ID="poolguard.testnet"

# Owner wallet account. The owner private key or seed phrase must never be
# configured in this file.
OWNER_ACCOUNT_ID="owner.testnet"

# Provider payout account. It receives contract payouts; the running provider
# does not need this account's private key.
PROVIDER_ACCOUNT_ID="extract.testnet"
PROVIDER_ORIGIN="https://provider.example.com"
PROVIDER_SERVICE_DOMAIN="provider.example.com"

# Restricted worker keys. Each key must be a function-call key scoped to
# POOLGUARD_CONTRACT_ID and only:
#   reserve, execute, cancel_reservation, expire_reservation
# Run one worker process per key. Remove full-access keys from these accounts.
# Worker custody. "local" (default): the restricted key below is in this env.
# "outlayer": the key lives in OutLayer's TEE; run `node scripts/outlayer-setup.mjs`
# to register wallets and fill WORKER_*_CUSTODY / _OUTLAYER_API_KEY / _ACCOUNT_ID.
# OUTLAYER_API_URL=https://testnet-api.outlayer.ai
# WORKER_ONE_CUSTODY=outlayer
# WORKER_ONE_OUTLAYER_API_KEY=wk_...
WORKER_ONE_ACCOUNT_ID="agent-one.testnet"
WORKER_ONE_PRIVATE_KEY="REPLACE_WITH_RESTRICTED_FUNCTION_CALL_KEY"
WORKER_TWO_ACCOUNT_ID="agent-two.testnet"
WORKER_TWO_PRIVATE_KEY="REPLACE_WITH_RESTRICTED_FUNCTION_CALL_KEY"

# A valid testnet account that is deliberately not on any task allowlist.
# Used for the contract-enforced vendor denial check.
POLICY_PROBE_PROVIDER_ACCOUNT_ID="policy-probe.testnet"

# --------------------------------------------------------------- public URLs
# These must be the exact public origins, without paths.
API_ORIGIN="https://api.example.com"
WEB_ORIGIN="https://app.example.com"

# The web app reads this at build time for the /api rewrite in next.config.ts.
# Set API_ORIGIN in the build environment too, not only at runtime.
API_HOST=0.0.0.0
API_PORT=4100
PROVIDER_HOST=0.0.0.0
PROVIDER_PORT=4103

# Wallet-selector receiver. This is public, not a secret.
NEXT_PUBLIC_POOLGUARD_CONTRACT_ID="poolguard.testnet"

# ------------------------------------------------------------------ secrets
# Generate with: openssl rand -base64 48
SESSION_SECRET="CHANGEME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
# Generate with: openssl rand -base64 32 (must decode to exactly 32 bytes)
DOCUMENT_ENCRYPTION_KEY="REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES"

# --------------------------------------------------------- safety switches
# All three must be explicitly false on public testnet.
LOCAL_SANDBOX_MODE=false
ALLOW_DEV_SESSION=false
FAULT_INJECTION_ENABLED=false

# Local-sandbox-only authority. Leave empty.
SANDBOX_OWNER_PRIVATE_KEY=
SANDBOX_PROVIDER_PRIVATE_KEY=

# ------------------------------------------------------ API proxy and limits
# The proxy IP/CIDR that fronts the API, never a hop count. Leave false when the
# API is directly exposed. Comma-separated IP/CIDR values are accepted.
API_TRUST_PROXY=false
API_RATE_LIMIT_MAX=300
# Worker-signed actions one signed-in account may trigger per hour. The two worker
# accounts are shared by every task, so this bounds one account's gas spend.
API_CHAIN_ACTIONS_PER_HOUR=60
# Comma-separated NEAR accounts allowed to sign in. Leave empty to allow anyone.
AUTH_ALLOWED_ACCOUNTS=
CHAIN_READ_CONCURRENCY=4

# ----------------------------------------------------------------- workers
WORKER_ID=worker-testnet-1
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=90
SESSION_TTL_DAYS=7

# --------------------------------------------------------------------- AI
# Optional. With no key, runs are clearly labelled scripted fixtures; the
# contract, provider and accounting still execute normally.
# Private inference: NEAR AI Cloud runs models in TEEs and signs every response.
# PoolGuard verifies those signatures per run. Get a key at https://cloud.near.ai
# (Credits, then API Keys). Pick a model with tool calling, e.g.:
#   AI_BASE_URL="https://cloud-api.near.ai/v1"
#   AI_MODEL="deepseek/deepseek-v4.1-flash"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000

# ------------------------------------------------------- admin & operations
# NEAR accounts that can open /admin (read-only). Comma-separated.
ADMIN_ACCOUNTS=
# Subset of ADMIN_ACCOUNTS that may take actions (retry jobs, suspend, hide…).
# Every action is written to the audit log.
ADMIN_OPERATOR_ACCOUNTS=
# Optional. The monitor POSTs {"text": "..."} here when an alert fires
# (Slack/Discord-compatible incoming webhook). Alerts are always logged too.
ALERT_WEBHOOK_URL=
# Set to true to turn off the in-process monitor (e.g. on a second API replica).
MONITOR_DISABLED=false
# Optional public contact shown on /contact and /legal. Leave empty to point
# people at GitHub issues and private security advisories instead.
CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_REPO_URL="https://github.com/Vict3310/poolguard"
# Base58 sha256 of the WASM you deployed (CI prints it). /admin compares the
# on-chain code hash against it; when empty it uses the local build.
POOLGUARD_EXPECTED_WASM_HASH=
