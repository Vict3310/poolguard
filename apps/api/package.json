{
  "name": "@poolguard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "pnpm --filter @poolguard/db db:generate",
    "db:migrate": "pnpm --filter @poolguard/db db:migrate",
    "db:seed": "pnpm --filter @poolguard/db db:seed"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@poolguard/agent-runtime": "workspace:*",
    "@poolguard/db": "workspace:*",
    "@poolguard/shared": "workspace:*",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "near-api-js": "7.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
